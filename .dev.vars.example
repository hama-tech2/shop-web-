# Copy to .dev.vars (git-ignored) for local `wrangler dev`.
#
# SERVER SIDE ONLY. The service_role key bypasses Row Level Security —
# it must never be shipped to the browser, never appear in /public,
# and never be committed. In production set it with:
#   wrangler secret put SUPABASE_SERVICE_ROLE_KEY
SUPABASE_SERVICE_ROLE_KEY=

# SERVER SIDE ONLY. Random salt for opaque client rate-limit keys.
# Generate independently from every other secret:
#   wrangler secret put VIEW_SALT
VIEW_SALT=

# Public Cloudflare Turnstile site key. The matching secret belongs only
# in Supabase Auth -> Bot and Abuse Protection, never in this Worker.
TURNSTILE_SITE_KEY=

# R2 credentials for the deleted_objects queue drain, if the job ever
# runs outside the Worker's R2 binding.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Wayl — the payment provider for subscriptions. SERVER SIDE ONLY.
# The token must never appear in /public or in wrangler.jsonc:
#   wrangler secret put WAYL_API_TOKEN
WAYL_API_TOKEN=

# "test" or "live". Anything else is read as "test".
WAYL_ENV=test

# The switch. Only the exact string "true" allows a charge to be made.
PAYMENTS_ENABLED=false

# REQUIRED once payments are on. The public https URL of
# /app/subscription/result. The webhook URL Wayl is given is built from
# its origin. It is never derived from the incoming request: a Host
# header is caller-controlled, and it must not decide where a paying
# seller is sent back to. Without it, no checkout is created.
WAYL_RETURN_URL=
