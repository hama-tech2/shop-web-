{
  "name": "shop-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shop Web — Kurdish (Sorani) social shopping app for sellers in Erbil",
  "scripts": {
    "test:image-sitemap": "node --test scripts/image-sitemap-test.mjs",
    "test:shop-sharing": "node scripts/run-permanent-free-tests.mjs --only=sharing",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "r2:create": "wrangler r2 bucket create shop-web-images",
    "db:push": "supabase db push",
    "db:diff": "supabase db diff",
    "test:security": "node scripts/security-test.mjs",
    "test:hardening": "node scripts/security-hardening-test.mjs",
    "test:favorites": "node scripts/favorites-test.mjs",
    "test:auth": "node scripts/auth-next-test.mjs",
    "test:affected": "node scripts/affected-rows-test.mjs",
    "test:publish": "node scripts/publish-flow-test.mjs",
    "test:onboarding": "node scripts/onboarding-flow-test.mjs",
    "test:categories": "node scripts/categories-test.mjs",
    "test:profile": "node scripts/profile-test.mjs",
    "test:category-ui": "node scripts/category-ui-test.mjs",
    "test:plan-state": "node scripts/plan-state-test.mjs",
    "test:subscription": "node scripts/subscription-test.mjs",
    "test:plan-limits": "node scripts/plan-limits-test.mjs",
    "test:telegram": "node scripts/telegram-test.mjs",
    "test:admin-grants": "node scripts/admin-grants-test.mjs",
    "test:wayl": "node scripts/wayl-test.mjs",
    "test:free-plan": "node scripts/free-plan-test.mjs",
    "test:retry": "node scripts/checkout-retry-test.mjs",
    "test:brand": "node scripts/brand-assets-test.mjs",
    "test:seo": "node scripts/seo-test.mjs",
    "test:owner-controls": "node scripts/owner-product-controls-test.mjs",
    "test:visibility": "node scripts/visibility-test.mjs",
    "test:visibility-ui": "node scripts/visibility-ui-test.mjs",
    "test:admin-access": "node scripts/admin-access-test.mjs",
    "test:free-db": "node --test scripts/permanent-free-db-test.mjs scripts/permanent-free-integration-db-test.mjs scripts/permanent-free-regression-test.mjs",
    "test:free-worker": "node --test scripts/plan-state-test.mjs scripts/permanent-free-worker-test.mjs",
    "test:free-browser": "node scripts/permanent-free-browser-test.mjs",
    "test:permanent-free": "node scripts/run-permanent-free-tests.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.9",
    "jsqr": "1.4.0",
    "playwright-core": "^1.49.0",
    "wrangler": "^4.42.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.58.0"
  }
}
